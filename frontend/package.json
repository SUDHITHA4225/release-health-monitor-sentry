{
  "name": "rhm-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-scripts": "5.0.1",
    "@sentry/react": "^7.0.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "release:create": "sentry-cli releases new $SENTRY_RELEASE",
    "release:upload": "sentry-cli releases files $SENTRY_RELEASE upload-sourcemaps build/static/js -u --url-prefix '~/static/js'",
    "release:finalize": "sentry-cli releases finalize $SENTRY_RELEASE"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
