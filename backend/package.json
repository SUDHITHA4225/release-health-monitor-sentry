{
  "name": "rhm-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test:crud": "node test_crud.js",
    "release:create": "sentry-cli releases new $SENTRY_RELEASE",
    "release:upload": "sentry-cli releases files $SENTRY_RELEASE upload-sourcemaps ./ -i main.js --url-prefix ~",
    "release:finalize": "sentry-cli releases finalize $SENTRY_RELEASE"
  },
  "dependencies": {
    "express": "^4.18.2",
    "@sentry/node": "^7.0.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5"
  }
}
